{
  "name": "bumfuzzle",
  "version": "1.9.2",
  "description": "Project scaffolding and validation",
  "bin": {
    "bumfuzzle": "scripts/bumfuzzle.sh",
    "bf": "scripts/bumfuzzle.sh"
  },
  "files": [
    "scripts/",
    "!scripts/tests/**",
    "skills/",
    "index.html",
    "bumfuzzle-template.yml",
    "schema.yml",
    "VERSION"
  ],
  "scripts": {
    "prepack": "scripts/sync-package-version.sh",
    "postinstall": "scripts/sync-skill.sh",
    "check": "scripts/prerequisites.sh bumfuzzle-template.yml && scripts/prerequisites.sh .bumfuzzle/config.yml && scripts/tests/run-all.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
